"""
================================================================================
     DUAL-VECTOR NEURAL-VR REMOTE MONITORING ENGINE (THERAPIST INTERFACE)
================================================================================
Core Engine Codebase for Remote Autotelic Immersion and Allostatic Validation
Telemetry Source: Smartwatch Type-C USB Port + Headset Mouthpiece VSA
Diagnostic Target: Remote Therapist WebRTC Dashboard Terminal
System Capacity Threshold: 94.4% Optimal Saturated Capacity
"""

import time
import math

def analyze_remote_telemetry(vsa_mouthpiece_db, vsa_frequency_hz, 
                             smartwatch_hrv, smartwatch_bpm, 
                             smartwatch_temp_c, current_audio_track,
                             is_morning_routine_active=True):
    """
    Therapist AI Interpretation Matrix: Ingests raw hardware data over local 
    Type-C USB serial pipelines and translates the controlled human subject's 
    physiological state into concrete diagnostic profiles.
    """
    
    # -------------------------------------------------------------------------
    # 1. HARDWARE VECTOR PROCESSING (Type-C USB & Audio Mouthpiece Line)
    # -------------------------------------------------------------------------
    # VSA Mouthpiece Voice Analyzer: Measures degradation of 8Hz-12Hz micro-tremors
    # Voice stress is marked by a drop in natural micro-tremor frequency oscillations.
    tremor_efficiency = max(0.0, min(1.0, (vsa_frequency_hz - 7.5) / 4.5))
    acoustic_sincerity = max(0.0, min(1.0, 1.0 - ((0.8 - tremor_efficiency) * 2.0)))
    
    # Smartwatch Type-C Cardiac Diagnostics (HRV & BPM)
    if smartwatch_hrv <= 0:
        smartwatch_hrv = 50
    cardiac_friction = max(0.0, min(1.0, (50.0 - smartwatch_hrv) / 50.0))
    cardiac_sincerity = max(0.0, min(1.0, 1.0 - cardiac_friction))

    # -------------------------------------------------------------------------
    # 2. THE OBSERVER INTERACTIVE MATRIX (CFSI CALCULATION)
    # -------------------------------------------------------------------------
    # If the controlled human is running their optimized Flow Morning Routine, 
    # the AI engine weights the stable Vagus-stimulated voice metrics over cardiac shifts.
    if is_morning_routine_active:
        acoustic_weight = 0.60
        cardiac_weight = 0.30
    else:
        acoustic_weight = 0.45
        cardiac_weight = 0.45

    cfsi_index = (acoustic_sincerity * acoustic_weight) + (cardiac_sincerity * cardiac_weight) + 0.10
    cfsi_score = round(cfsi_index * 100, 1)

    # -------------------------------------------------------------------------
    # 3. REMOTE FLOW TRIGGER TRACKING & SATURATION OUTPUT
    # -------------------------------------------------------------------------
    # Evaluation 01: Vagal Pacing Intensity (Extrapolated from VSA cadence)
    vagal_pacing_trigger = min(100.0, (vsa_mouthpiece_db / -12.0) * 100.0) if vsa_mouthpiece_db < 0 else 30.0
    
    # Evaluation 02: Hydro-Shock Thermal Break (Logged by Smartwatch Core Thermistor)
    hydro_shock_trigger = min(100.0, max(0.0, (37.0 - smartwatch_temp_c) * 50.0)) if smartwatch_temp_c < 36.0 else 0.0
    
    # Evaluation 03: Acoustic Rhythm Sync
    acoustic_sync_trigger = 100.0 if current_audio_track in ["Limp Bizkit", "RAF Camora", "Green Day", "T.Q."] else 30.0

    # Calculate Total Saturated Cognitive Level
    flow_saturation = (vagal_pacing_trigger * 0.40) + (hydro_shock_trigger * 0.40) + (acoustic_sync_trigger * 0.20)
    
    if is_morning_routine_active:
        flow_saturation = min(94.4, flow_saturation + 10.0) # Organic ritual multiplier
        
    if cfsi_score < 40.0:
        flow_saturation = max(0.0, flow_saturation - 40.0) # Cognitive Prison penalty

    return cfsi_score, round(flow_saturation, 1), vagal_pacing_trigger, hydro_shock_trigger, acoustic_sync_trigger
