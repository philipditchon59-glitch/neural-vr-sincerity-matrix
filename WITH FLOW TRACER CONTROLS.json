     DUAL-VECTOR NEURAL-VR REMOTE MONITORING ENGINE (THERAPIST INTERFACE)
================================================================================

def calculate_flow_state_metrics_v3(mantra_count, core_temp_celsius, audio_track_vibe, 
                                    audio_baseline_tremor, audio_response_tremor, 
                                    hrv_baseline, hrv_response, bpm_current,
                                    is_morning_routine_active=True):
    """
    Calculates the Cognitive Friction & Sincerity Index (CFSI) with the upgraded
    FLOW MORNING ROUTINE TRIGGER ENGINE.
    """
    # -------------------------------------------------------------------------
    # 1. DYNAMIC ROUTINE TRIGGER MATRIX (Replaces Caffeine Override)
    # -------------------------------------------------------------------------
    # When the Flow Morning Routine Trigger is engaged, the system locks into a high-performance 
    # autotelic immersion profile, adjusting algorithmic weights to prioritize organic, structured stability.
    if is_morning_routine_active:
        acoustic_weight = 0.60  # Locked on Vagus Nerve alignment via vocal stability
        cardiac_weight = 0.30   # Grounded on Allostatic cardio-telemetry
    else:
        acoustic_weight = 0.45
        cardiac_weight = 0.45

    # Acoustic Delta (Vagus Nerve Micro-Tremor Loss)
    tremor_loss = audio_baseline_tremor - audio_response_tremor
    acoustic_score = max(0.0, min(1.0, 1.0 - (tremor_loss * 2.5)))
    
    # Cardiac Stability (Heart Rate Variability Drop)
    hrv_drop = hrv_baseline - hrv_response
    cardiac_score = max(0.0, min(1.0, 1.0 - (hrv_drop / hrv_baseline)))
    
    # Promethean Fusion Formula (Dynamic Weights + 10% Structural Baseline Anchor)
    cfsi_index = (acoustic_score * acoustic_weight) + (cardiac_score * cardiac_weight) + 0.10
    cfsi_score = round(cfsi_index * 100, 1)

    # -------------------------------------------------------------------------
    # 2. FLOW TRIGGERS INDEX CALCULATION
    # -------------------------------------------------------------------------
    vagal_pacing_trigger = min(100.0, (mantra_count / 105.0) * 100.0)
    hydro_shock_trigger = min(100.0, max(0.0, (37.0 - core_temp_celsius) * 50.0)) if core_temp_celsius < 36.0 else 0.0
    acoustic_sync_trigger = 100.0 if audio_track_vibe in ["Limp Bizkit", "RAF Camora", "Green Day", "T.Q."] else 30.0

    # -------------------------------------------------------------------------
    # 3. REAL-TIME COGNITIVE SATURATION (FLOW STATE LEVEL)
    # -------------------------------------------------------------------------
    flow_saturation = (vagal_pacing_trigger * 0.40) + (hydro_shock_trigger * 0.40) + (acoustic_sync_trigger * 0.20)
    
    if is_morning_routine_active:
        flow_saturation = min(94.4, flow_saturation + 10.0) # Organic routine catalyst bump
    
    if cfsi_score < 40.0:
        flow_saturation = max(0.0, flow_saturation - 40.0)

    return cfsi_score, round(flow_saturation, 1)
