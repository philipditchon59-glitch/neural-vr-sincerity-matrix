def calculate_flow_state_metrics(mantra_count, core_temp_celsius, audio_track_vibe, 
                                 audio_baseline_tremor, audio_response_tremor, 
                                 hrv_baseline, hrv_response, bpm_current):
    """
    Core Fusion Engine: Processes dual-vector polygraph metrics alongside 
    real-time biological and environmental Flow Triggers to calculate the 
    Cognitive Friction & Sincerity Index (CFSI) and the Flow Saturation Level.
    """
    # -------------------------------------------------------------------------
    # 1. DUAL-VECTOR POLYGRAPH CORE & CAFFEINE OVERRIDE FAIL-SAFE
    # -------------------------------------------------------------------------
    caffeine_override_active = bpm_current > 100
    if caffeine_override_active:
        acoustic_weight = 0.70
        cardiac_weight = 0.20
    else:
        acoustic_weight = 0.45
        cardiac_weight = 0.45

    # Acoustic Delta (Vagus Nerve Micro-Tremor Loss)
    tremor_loss = audio_baseline_tremor - audio_response_tremor
    acoustic_score = max(0.0, min(1.0, 1.0 - (tremor_loss * 2.5)))
    
    # Advanced Heart Rate Variability Logic
    if hrv_baseline <= 0:
        hrv_baseline = 50  # Fault-tolerant baseline default
    hrv_drop = hrv_baseline - hrv_response
    cardiac_score = max(0.0, min(1.0, 1.0 - (hrv_drop / hrv_baseline)))
    
    # Promethean Fusion Formula for CFSI (Weighted Inputs + 10% Constant Anchor)
    cfsi_index = (acoustic_score * acoustic_weight) + (cardiac_score * cardiac_weight) + 0.10
    cfsi_score = round(cfsi_index * 100, 1)

    # -------------------------------------------------------------------------
    # 2. REAL-TIME FLOW TRIGGER VECTOR ANALYTICS
    # -------------------------------------------------------------------------
    # Trigger 01: Vagal Reset Pacing (Target: 105 structural bead repetitions)
    vagal_pacing_trigger = min(100.0, (mantra_count / 105.0) * 100.0)
    
    # Trigger 02: Hydro-Shock Thermal Circuit Breaker (Target Core Shock < 36.0 C)
    if core_temp_celsius < 36.0:
        # Shock activation translates drops under normal skin baseline to a high performance value
        hydro_shock_trigger = min(100.0, max(0.0, (37.0 - core_temp_celsius) * 50.0))
    else:
        hydro_shock_trigger = 0.0

    # Trigger 03: Acoustic Rhythm Synchronization (Target: High-energy rock/metal vibe matrix)
    if audio_track_vibe in ["Limp Bizkit", "RAF Camora", "Green Day", "T.Q."]:
        acoustic_sync_trigger = 100.0
    else:
        acoustic_sync_trigger = 30.0

    # -------------------------------------------------------------------------
    # 3. REAL-TIME COGNITIVE SATURATION INDEX (FLOW STATE LEVEL)
    # -------------------------------------------------------------------------
    # Systemic distribution: 40% Vagal, 40% Hydro-Shock, 20% Soundscape Rhythm
    flow_saturation = (vagal_pacing_trigger * 0.40) + (hydro_shock_trigger * 0.40) + (acoustic_sync_trigger * 0.20)
    
    # Overriding Cognitive Prison Protection: 
    # If polygraph indices detect high cognitive strain, internal harmony drops.
    if cfsi_score < 40.0:
        flow_saturation = max(0.0, flow_saturation - 40.0)

    # Lock and secure maximum cap ceiling matching narrative metrics
    if flow_saturation > 94.4:
        flow_saturation = 94.4

    return (cfsi_score, round(flow_saturation, 1), caffeine_override_active, 
            vagal_pacing_trigger, hydro_shock_trigger, acoustic_sync_trigger)

